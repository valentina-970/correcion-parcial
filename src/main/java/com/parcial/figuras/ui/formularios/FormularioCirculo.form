<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.parcial.figuras.ui.formularios.FormularioCirculo">
  <grid id="2c4fc" binding="panel" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="560" height="300"/>
    </constraints>
    <properties>
      <background color="-659477"/>
    </properties>
    <border type="empty">
      <size top="10" left="10" bottom="10" right="10"/>
    </border>
    <children>
      <component id="2c4d0" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="4" left="6" bottom="10" right="6" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <font size="15" style="1"/>
          <foreground color="-13680298"/>
          <text value="Medidas"/>
        </properties>
      </component>
      <component id="2c4db" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="4" left="6" bottom="4" right="6" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <font style="1"/>
          <foreground color="-13680298"/>
          <text value="Radio"/>
        </properties>
      </component>
      <component id="2c4e6" class="javax.swing.JTextField" binding="txtRadio">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="4" left="4" bottom="4" right="4" weightx="1.0" weighty="0.0"/>
        </constraints>
        <properties>
          <columns value="6"/>
          <foreground color="-13680298"/>
          <horizontalAlignment value="0"/>
          <text value="60"/>
        </properties>
      </component>
      <component id="2c4f1" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="4" left="6" bottom="4" right="6" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <font style="1"/>
          <foreground color="-13680298"/>
          <text value="px"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
